# ───────────── Database (pgvector on PostgreSQL 17)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rag_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ─�──────────── Application
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
WORKER_BATCH_SIZE=50
WORKER_FLUSH_INTERVAL=5.0

# ───────────── Drift thresholds
DRIFT_THRESHOLD=0.15
MMD_THRESHOLD=0.1
PER_COMPONENT_KL_THRESHOLD=0.5

# ───────────── Redis (durable ingestion buffer)
REDIS_URL=redis://localhost:6379/0
REDIS_STREAM_KEY=telemetry:frames:stream
REDIS_CONSUMER_GROUP=drift_engine_workers
REDIS_CONSUMER_NAME=worker_1

# ───────────── Rate limiting
RATE_LIMIT_PER_MINUTE=600

# ───────────── API Key security
API_KEY_REQUIRED=False
API_KEYS=

# ───────────── CORS
CORS_ORIGINS=*

# ───────────── Alerting (optional)
DRIFT_ALERT_WEBHOOK_URL=

# ───────────── Model provider keys (optional)
LITELLM_MASTER_KEY=sk-mock-key-1234
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ───────────── Pool sizes
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
